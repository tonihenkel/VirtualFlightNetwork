{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Plugin Release x64",
            "type": "shell",
            "command": "${workspaceFolder}\\build.cmd",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Rebuild Plugin Release x64",
            "type": "shell",
            "command": "${workspaceFolder}\\build.cmd",
            "args": [
                "rebuild"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}
